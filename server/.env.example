# Django Core
SECRET_KEY=your-django-secret-key-change-this-in-production
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Neon connection pooler URL — keep sslmode=require & channel_binding=require
DATABASE_URL=postgresql://neondb_owner:npg_T5gYmKUbCXG2@ep-wandering-union-az81w59x-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
